{
  "expo": {
    "name": "DreamerDrop Downloader",
    "slug": "dreamerdrop-downloader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dreamerdrop",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "DreamerDrop saves downloaded videos to your gallery.",
        "NSPhotoLibraryUsageDescription": "DreamerDrop needs access to save media to your library."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050508",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_VIDEO",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_IMAGES"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#050508",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 120
          }
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow DreamerDrop to save downloads to your gallery.",
          "savePhotosPermission": "Allow DreamerDrop to save downloads to your gallery."
        }
      ],
      "expo-sharing",
      "expo-secure-store",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://dreamer-video-downloader-c2nz2pwjg-asaiah4812s-projects.vercel.app/api/v1",
      "eas": {
        "projectId": "dreamerdrop-downloader"
      }
    }
  }
}

